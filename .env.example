# Local development only; deployment injects its own environment.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Native/hybrid connection. Containers use the Compose service name internally.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clean_api_db
DB_CONNECT_TIMEOUT_MS=5000

# Comma-separated browser origins; empty disables cross-origin browser access.
CORS_ORIGINS=
# Set only when every request passes through this exact trusted proxy topology.
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT_MS=10000
